{
 "doctype": "DocType",
 "name": "Risk Factor",
 "module": "Insurance",
 "autoname": "field:factor_name",
 "fields": [
  {
   "fieldname": "factor_name",
   "fieldtype": "Data",
   "label": "Factor Name",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "factor_category",
   "fieldtype": "Select",
   "label": "Factor Category",
   "options": "Health\nLifestyle\nOccupation\nLocation\nFinancial\nOther",
   "reqd": 1
  },
  {
