   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0
  },
  {
   "role": "Insurance Agent",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0
  },
  {
   "role": "Claims Adjuster",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0
  }
 ]
}