{
 "doctype": "DocType",
 "name": "Premium Payment",
 "module": "Insurance",
 "autoname": "naming_series:",
 "is_submittable": 1,
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "INS-PAY-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "insurance_policy",
   "fieldtype": "Link",
   "label": "Insurance Policy",
   "options": "Insurance Policy",
   "reqd": 1
  },
  {
   "fieldname": "policy_number",
   "fieldtype": "Data",
   "label": "Policy Number",
   "fetch_from": "insurance_policy.policy_number",
   "read_only": 1
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer",
   "fetch_from": "insurance_policy.customer",
   "read_only": 1
  },
  {
   "fieldname": "payment_date",
   "fieldtype": "Date",
   "label": "Payment Date",
   "reqd": 1,
   "default": "Today"
  },
  {
   "fieldname": "payment_mode",
   "fieldtype": "Select",
   "label": "Payment Mode",
   "options": "Cash\nCheque\nOnline\nUPI\nCard",
   "reqd": 1
  },
  {
   "fieldname": "payment_amount",
   "fieldtype": "Currency",
   "label": "Payment Amount",
   "reqd": 1
  },
  {
   "fieldname": "due_amount",
   "fieldtype": "Currency",
   "label": "Due Amount",
   "read_only": 1
  },
  {
   "fieldname": "late_fee",
   "fieldtype": "Currency",
   "label": "Late Fee"
  },
  {
   "fieldname": "total_amount",
   "fieldtype": "Currency",
   "label": "Total Amount",
   "read_only": 1
  },
  {
   "fieldname": "payment_status",
   "fieldtype": "Select",
   "label": "Payment Status",
   "options": "Pending\nCompleted\nFailed\nRefunded",
   "default": "Pending"
  },
  {
   "fieldname": "payment_reference",
   "fieldtype": "Data",
   "label": "Payment Reference"
  },
  {
   "fieldname": "transaction_id",
   "fieldtype": "Data",
   "label": "Transaction ID"
  },
  {
   "fieldname": "receipt_number",
   "fieldtype": "Data",
   "label": "Receipt Number"
  }
 ],
 "permissions": [
  {
   "role": "Insurance Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 1,
   "cancel": 1
  },
  {
   "role": "Insurance Agent",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0
  },
  {
   "role": "Insurance Customer",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0
  },
  {
   "role": "Claims Adjuster",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0
  }
 ]
}